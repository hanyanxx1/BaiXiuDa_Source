    "10.165.0.0/16"
    "171.11.0.0/16"
)
# ---------------------------------

# 1. 准备 ipset 集合
echo "[1/4] 创建/清空 ipset 集合 ${IPSET_NAME} ..."
if ipset list ${IPSET_NAME} &>/dev/null; then
    ipset flush ${IPSET_NAME}
else
    ipset create ${IPSET_NAME} hash:net
fi

# 2. 添加允许的网段（自动检测并补全缺失掩码的IP为 /32）
echo "[2/4] 添加允许的网段到 ipset ..."
for net in "${ALLOWED_NETWORKS[@]}"; do
    # 检查是否包含子网掩码，若无则添加 /32 并给出警告
    if [[ ! "$net" =~ /[0-9]+$ ]]; then
        echo "  -> 警告: '$net' 不含子网掩码，将作为单个 IP 添加 ($net/32)"
        net="${net}/32"
    fi
    if ipset add ${IPSET_NAME} ${net} 2>/dev/null; then
        echo "  -> 已添加 ${net}"
    else
        echo "  -> 错误: 添加 ${net} 失败，请检查格式"
    fi
done

# 3. 清理旧规则（仅针对 52666 端口）
echo "[3/4] 清理旧规则（端口 ${PORT}） ..."
iptables -D INPUT -p udp --dport ${PORT} -m set --match-set ${IPSET_NAME} src -j ACCEPT 2>/dev/null || true
iptables -D INPUT -p tcp --dport ${PORT} -m set --match-set ${IPSET_NAME} src -j ACCEPT 2>/dev/null || true
iptables -D INPUT -p udp --dport ${PORT} -j DROP 2>/dev/null || true
iptables -D INPUT -p tcp --dport ${PORT} -j DROP 2>/dev/null || true

# 4. 添加新规则（白名单优先）
echo "[4/4] 添加新规则（白名单 -> DROP） ..."
iptables -I INPUT 1 -p udp --dport ${PORT} -m set --match-set ${IPSET_NAME} src -j ACCEPT
iptables -I INPUT 1 -p tcp --dport ${PORT} -m set --match-set ${IPSET_NAME} src -j ACCEPT
iptables -A INPUT -p udp --dport ${PORT} -j DROP
iptables -A INPUT -p tcp --dport ${PORT} -j DROP

# 5. 持久化保存
echo "[5/5] 持久化保存规则..."

# --- iptables 保存 ---
if command -v netfilter-persistent >/dev/null 2>&1; then
    netfilter-persistent save
    echo "  -> iptables 规则已通过 netfilter-persistent 保存。"
else
    mkdir -p /etc/iptables
    iptables-save > /etc/iptables/rules.v4
    echo "  -> iptables 规则已保存到 /etc/iptables/rules.v4。"
    echo "     未安装 iptables-persistent，请确保系统重启后加载此文件。"
fi

# --- ipset 保存 ---
IPSET_SAVE_FILE="/etc/iptables/ipset"
mkdir -p /etc/iptables
ipset save > ${IPSET_SAVE_FILE}
echo "  -> 所有 ipset 集合已保存到 ${IPSET_SAVE_FILE}"

if systemctl is-active --quiet ipset-persistent; then
    systemctl restart ipset-persistent
    echo "  -> ipset-persistent 服务已重启。"
else
    systemctl enable ipset-persistent 2>/dev/null || true
    systemctl start ipset-persistent 2>/dev/null || true
    echo "  -> ipset-persistent 服务已启用并启动。"
fi

echo ""
echo "✅ 配置完成！当前 ${PORT} 端口规则如下："
iptables -L INPUT -n -v --line-numbers | grep "dpt:${PORT}"

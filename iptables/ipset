#!/bin/bash
# ============================================================
# 功能：限制 TCP/UDP 52666 端口只允许指定的网段访问
# 适用：Debian 11 (已安装 ipset, iptables-persistent, ipset-persistent)
# 用法：sudo bash setup_whitelist_52666.sh
# ============================================================

set -e

# ---------- 前置依赖检查 ----------
echo "检查必要命令..."
for cmd in iptables ipset; do
    if ! command -v $cmd >/dev/null 2>&1; then
        echo "错误: 未找到命令 $cmd，请先安装 iptables 和 ipset。"
        exit 1
    fi
done

if command -v ipset-persistent >/dev/null 2>&1; then
    echo "  -> ipset-persistent 已安装，将使用服务持久化。"
else
    echo "警告: ipset-persistent 未安装，重启后 ipset 规则可能丢失。"
    echo "      建议执行: sudo apt install ipset-persistent"
fi

# ---------- 可修改变量 ----------
IPSET_NAME="pscc_allow"               # ipset 集合名称
PORT="52666"                           # 目标端口

# 允许的网段列表（请务必使用 CIDR 格式，如 192.168.1.0/24）
ALLOWED_NETWORKS=(
    "1.198.38.0/24"
    "221.14.88.0/24"
    "42.51.32.0/24"
    "42.51.33.0/24"
    "42.51.37.0/24"
    "42.51.38.0/24"
    "42.51.40.0/24"
    "42.51.41.0/24"
    "42.51.42.0/24"
    "42.224.10.0/24"
    "42.224.90.0/24"
    "42.224.92.0/24"
    "42.224.93.0/24"
    "42.224.141.0/24"
    "42.224.143.0/24"
    "42.224.224.0/24"
    "42.224.228.0/24"
    "42.224.231.0/24"
    "42.228.236.0/24"
    "42.228.237.0/24"
    "42.228.238.0/24"
    "115.50.151.0/24"
    "115.50.152.0/24"
    "115.50.154.0/24"
    "123.5.138.0/24"
    "123.5.140.0/24"
    "123.5.176.0/24"
    "123.5.183.0/24"
    "123.9.218.0/24"
    "123.162.186.0/24"
    "123.162.187.0/24"
    "125.40.138.0/24"
    "125.40.159.0/24"
    "125.43.126.0/24"
    "125.43.127.0/24"
    "182.121.76.0/24"
    "182.121.142.0/24"
    "182.121.143.0/24"
    "219.157.9.0/24"
    "222.141.25.0/24"
    "61.158.166.0/24"
    "183.185.109.0/24"
    "8.130.15.135"
    "125.40.158.0/24"
    "182.121.66.0/24"
    "42.235.149.0/24"
    "123.5.137.0/24"
    "42.224.73.0/24"
    "42.224.80.0/24"
    "42.235.146.0/24"
    "42.228.233.0/24"
    "42.235.148.0/24"
    "115.50.73.0/24"
